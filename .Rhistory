geom_bar() + theme(axis.text.x = element_text(angle = 30, vjust = 0.8)) +
labs(x="BAS 24 Vac Lot Sentiment") + ylim(c(0,1000))
vac_bldg24 <- ggplot(data = bas24, mapping = aes(x = bas24_nhd_pdvbldg)) +
