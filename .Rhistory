year = 2024, geometry = T, survey = "acs5",
tigris_use_cache = T)
# Get ACS data for num buildings by census tract
acsData <- get_acs(geography = "tract", state = "MD", county = "Baltimore city",
variables = c(housing_units = "B25001_001"),
year = 2024, geometry = T, survey = "acs5")
View(acsData)
st_intersects(acsData, vbnCityData)
st_crs(acsData)
acsData <- `st_crs<-`(vbnCityData)
acsData <- `st_crs<-`(4326)
?st_Crs
?st_crs
st_crs(acsData) <- `st_crs<-`(4326)
st_crs(acsData) <- `st_crs<-`("4326")
acsData <- `st_crs<-`(acsData, 4326)
?st_transform
acsData <- st_transform(acsData, 4326)
st_crs(acsData)
st_intersects(acsData, vbnCityData)
acs_vacant_per_1k_blds <- acsData %>%
mutate(vacant_num = lengths(st_intersects(acsData, vbnCityData)),
vacant_per_1k_bldg = estimate / vacant_num * 1000)
View(acs_vacant_per_1k_blds)
acs_vacant_per_1k_blds <- acsData %>%
mutate(vacant_num = lengths(st_intersects(acsData, vbnCityData)),
vacant_per_1k_bldg = vacant_num / estimate * 1000)
acs_vacant_per_1k_blds <- acsData %>%
mutate(vacant_num = lengths(st_intersects(acsData, vbnCityData)),
vacant_per_1k_bldg = round(vacant_num / estimate * 1000))
