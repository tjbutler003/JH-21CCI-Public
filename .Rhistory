#| label: Mapping VBNs per 1000 buildings
# Used ACS For # buildings, VBN from open baltimore for vacant building count
tm_shape(osm_tiles) +
tm_rgb() +
tm_shape(acs_vacant_per_1k_blds) +
tm_polygons(fill = "vacant_per_1k_bldg",
fill.scale = tm_scale(),
fill_alpha = 0.5) %>%
tmap_save(., "vbns_per_1k_buildings_census_tract.png")
#| label: Mapping VBNs per 1000 buildings
# Used ACS For # buildings, VBN from open baltimore for vacant building count
tm_shape(osm_tiles) +
tm_rgb() +
tm_shape(acs_vacant_per_1k_blds) +
tm_polygons(fill = "vacant_per_1k_bldg",
fill.scale = tm_scale(),
fill_alpha = 0.5) %>%
tmap_save("vbns_per_1k_buildings_census_tract.png")
