#| label: setup
#| include: false
if(!require("pacman")) install.packages("pacman")
pacman::p_load("tidyverse", "sf", "mapview", "gridExtra", "survey", "devtools",
"ggmosaic", "basemaps", "tidycensus", "tmap", "basemaps",
"maptiles", "tidygeocoder", "openxlsx2")
# Get basemap using maptiles
osm_tiles <- get_tiles(vbnCityData, provider = "OpenStreetMap",
zoom = 12, crop = T, cachedir = "osm_tiles")
#| label: Number and Rate Responses by CSA
# QUESTION: Does 21CCI have number of responses mailed to each CSA, to review
# response rate by CSA???
tm_shape(osm_tiles) +
tm_rgb() +
tm_title("Num Responses per CSA BAS24") +
tm_shape(acs_to_csa_final) +
tm_polygons(fill = "n_bas24",
fill.scale = tm_scale(),
fill_alpha = 0.75)
tm_shape(osm_tiles) +
tm_rgb() +
tm_title("Responses/1000 Residents by CSA BAS24") +
tm_shape(acs_to_csa_final) +
tm_polygons(fill = "n_per_1k_bas24",
fill_alpha = 0.75)
