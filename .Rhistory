tm_polygons(fill = "vacant_per_1k_bldg",
fill.scale = tm_scale(),
fill_alpha = 0.5)
tmap_save(vbns_per_1k_bldgs_census_tract,
"vbns_per_1k_buildings_census_tract.png")
vbns_per_1k_bldgs_csa <-
tm_shape(acs_to_csa) +
tm_polygons(fill_alpha = 0.6,
fill = "vac_bldg_per_1k")
tmap_save(vbns_per_1k_bldgs_csa, "vbns_per_1k_buildings_csa.png")
#| label: BAS Sentiment Histogram
# Percentage of response option
bas24_vac_lot <- bas24 %>%
count(bas24_nhd_pdvlot) %>%
mutate(Percent = round(n / nrow(bas24) * 100, 1))
bas24_vac_bldg <- bas24 %>%
count(bas24_nhd_pdvbldg) %>%
mutate(Percent = round(n / nrow(bas24) * 100, 1))
bas25_vac_bldg <- bas25 %>%
count(bas25_nhd_pbvbld) %>%
mutate(Percent = round(n / nrow(bas25) * 100, 1))
vac_lot24 <- ggplot(data = bas24_vac_lot,
mapping = aes(x = bas24_nhd_pdvlot, y = Percent)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 30, vjust = 0.8)) +
labs(x="BAS24 Vac Lot") + ylim(c(0,60))
vac_bldg24 <- ggplot(data = bas24_vac_bldg,
mapping = aes(x = bas24_nhd_pdvbldg,
y = Percent)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 30, vjust = 0.8)) +
labs(x="BAS24 Vac Bldg") + ylim(c(0,60))
vac_bldg25 <- ggplot(data = bas25_vac_bldg,
mapping = aes(x = bas25_nhd_pbvbld, y = Percent)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 30, vjust = 0.8)) +
labs(x="BAS25 Vac Bldg") + ylim(c(0,60))
gridExtra::grid.arrange(vac_lot24, vac_bldg24, vac_bldg25, ncol = 3)
#| label: Number and Rate Responses by CSA
# QUESTION: Does 21CCI have number of responses mailed to each CSA, to review
# response rate by CSA???
tm_shape(osm_tiles) +
tm_rgb() +
tm_title("Num Responses per CSA BAS24") +
tm_shape(acs_to_csa_final) +
tm_polygons(fill = "n_bas24",
fill.scale = tm_scale(),
fill_alpha = 0.75)
tm_shape(osm_tiles) +
tm_rgb() +
tm_title("Rate/1000 Responses per CSA BAS24") +
tm_shape(acs_to_csa_final) +
tm_polygons(fill = "n_per_1k_bas24",
fill_alpha = 0.75)
