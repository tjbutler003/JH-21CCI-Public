vbldg_binary =
ifelse(bas24_nhd_pdvbldg %in% c("Somewhat of a problem","A big problem"),
1, 0),
vlot_binary =
ifelse(bas24_nhd_pdvlot %in% c("Somewhat of a problem", "A big problem"),
1, 0))
